EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The URL is the PROJECT url, not the REST endpoint the dashboard shows most
# prominently. supabase-js appends /auth/v1 and /rest/v1 itself, so a value
# ending in one of those produces requests to .../rest/v1/auth/v1/... which fail
# without an HTTP status and look like the device is offline.
